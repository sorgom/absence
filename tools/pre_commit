#!/usr/bin/env sh
set -eu

# Optional pre_commit hook for the Abwesenheits-App.
#
# It keeps commits honest by checking that the central version file exists
# and that the PHP footer reads the version dynamically instead of containing
# a manually edited hard-coded release number.

if [ ! -f version ]; then
    echo "ERROR: version file is missing." >&2
    exit 1
fi

version_VALUE="$(tr -d '[:space:]' < version)"

if [ -z "$version_VALUE" ]; then
    echo "ERROR: version file is empty." >&2
    exit 1
fi

case "$version_VALUE" in
    *[!0-9.]*)
        echo "ERROR: version must contain a simple numeric version such as 0.4.3." >&2
        exit 1
        ;;
esac

if ! grep -q "AppInfo::version()" templates/footer.php; then
    echo "ERROR: templates/footer.php must read the version via AppInfo::version()." >&2
    exit 1
fi

exit 0
